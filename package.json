{
  "name": "lar-imoveis",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:legacy:check": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate:legacy": "tsx scripts/migrate-sqlite-to-postgres.ts --execute",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "seed": "npx tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "resend": "^6.20.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "ws": "^8.21.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
