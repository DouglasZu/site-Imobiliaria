# PostgreSQL / Neon
# Runtime do app: URL pooled (hostname Neon com -pooler).
DATABASE_URL=""
# Prisma CLI/migrations: URL direta/unpooled (hostname sem -pooler).
DIRECT_URL=""
# Produção/Vercel: neon. CI com serviço PostgreSQL efêmero: pg.
DATABASE_ADAPTER="neon"

# Sessão administrativa. Gere uma chave exclusiva com pelo menos 32 caracteres.
JWT_SECRET=""

# Admin para fixtures locais/CI ou para `npm run admin:provision`.
ADMIN_EMAIL=""
# 12–72 caracteres e no máximo 72 bytes UTF-8, com maiúscula, minúscula, número e símbolo.
ADMIN_PASSWORD=""
# Seed de demonstração: deixe vazio. Em produção, exige UPSERT_DEMO_FIXTURES.
SEED_PRODUCTION_CONFIRM=""

# WhatsApp padrão para contato (DDI + DDD + número, somente dígitos).
WHATSAPP_PHONE=""

# URL canônica pública.
SITE_URL="http://localhost:3000"

# Cloudflare R2 — credenciais somente no servidor.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Origem HTTPS do domínio público customizado, sem caminho ou barra final.
R2_PUBLIC_URL=""

# Resend — somente no servidor.
RESEND_API_KEY=""
EMAIL_FROM=""
CONTACT_EMAIL=""

# Pusher Channels. Os pares KEY/CLUSTER devem ter os mesmos valores.
PUSHER_APP_ID=""
PUSHER_SECRET=""
PUSHER_KEY=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Protege /api/cron/cleanup-uploads; mínimo de 32 caracteres.
CRON_SECRET=""

# Migração one-off do catálogo SQLite (não usadas pelo runtime).
LEGACY_SQLITE_PATH=""
LEGACY_MIGRATION_CONFIRM=""
