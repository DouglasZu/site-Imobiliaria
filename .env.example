# Banco de dados SQLite local
DATABASE_URL="file:./dev.db"

# Obrigatório. Gere uma chave única: openssl rand -base64 32
JWT_SECRET=""

# Credenciais do Admin (usadas apenas pelo seed)
ADMIN_EMAIL=""
# De 12 a 72 caracteres (e no máximo 72 bytes UTF-8), com maiúscula, minúscula, número e símbolo.
ADMIN_PASSWORD=""

# O seed APAGA e recria catálogo e admins. Preencha com
# REPLACE_CATALOG_AND_ADMINS somente durante uma execução intencional.
SEED_REPLACE_CONFIRM=""

# Segunda trava. Mantenha false; produção exige autorização explícita adicional.
ALLOW_PRODUCTION_SEED="false"

# WhatsApp padrão para contato
WHATSAPP_PHONE=""

# URL pública usada em metadados, sitemap e robots.txt
SITE_URL="http://localhost:3000"
